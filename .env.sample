REACT_APP_TEXT="I'm REACT_APP_TEXT from .env"

# 后端 API 基础路径（经 vite /api/ 代理转发）
VITE_API_BASE_URL=/api

# 开发代理目标（默认 http://127.0.0.1:8080，可指向其它后端环境）
# VITE_PROXY_TARGET=http://8.136.229.208:8080

# 乐享知识库团队ID
VITE_LEXIANG_TEAM_ID=your_team_id_here

# OSS 上传配置（构建时通过 ENABLE_OSS=true 启用）
VITE_OSS_ACCESSKEY_ID=your_oss_access_key_id
VITE_OSS_ACCESSKEY_SECRET=your_oss_access_key_secret
